{
  "name": "three-control-rig",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Control-Rig-inspired TypeScript rigging runtime and embeddable Three.js editor.",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./core": {
      "types": "./dist/lib/core/index.d.ts",
      "import": "./dist/lib/core/index.js"
    },
    "./three": {
      "types": "./dist/lib/three/index.d.ts",
      "import": "./dist/lib/three/index.js"
    },
    "./editor": {
      "types": "./dist/lib/editor/index.d.ts",
      "import": "./dist/lib/editor/index.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "build:demo": "vite build",
    "build:lib": "tsc -p tsconfig.build.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build:lib && node tests/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@types/three": "^0.164.0",
    "three": "^0.164.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
